#!/usr/bin/env bash
# Runs the private assistant: Ollama (the model) and Open WebUI (the chat site).
#   ./privatellm start | stop | restart | status | doctor | pull | configure | sync | skills | reset-password | reindex | logs
#   ./privatellm access | contributor | library | export-user | delete-user | audit | training
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETTINGS="$ROOT/settings.env"
RUN_DIR="$ROOT/run"
LOG_DIR="$ROOT/logs"
DATA_DIR="$ROOT/data"
BRAND_DIR="$ROOT/branding"
OLLAMA_URL="${OLLAMA_URL:-http://127.0.0.1:11434}"
START_TIMEOUT_SECONDS=180
STOP_TIMEOUT_SECONDS=30
# Loading a model of several GB from an external drive can take a few minutes.
WARM_UP_TIMEOUT_SECONDS=300
# Below this much free memory, macOS starts swapping and the Mac can freeze.
LOW_MEMORY_PERCENT=25

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

load_settings() {
  [[ -f "$SETTINGS" ]] || fail "settings.env not found. Run ./setup.sh first."
  set -a
  # shellcheck disable=SC1090
  source "$SETTINGS"
  # shellcheck disable=SC1091
  source "$ROOT/config/openwebui.env"
  if [[ -f "$BRAND_DIR/brand.env" ]]; then
    # shellcheck disable=SC1091
    source "$BRAND_DIR/brand.env"
  fi
  set +a
  # Model files live with the project, so they are on whichever drive it is on.
  MODELS_DIR="${MODELS_DIR:-$ROOT/models}"
  # Use the programs setup.sh installed under this folder.
  # shellcheck disable=SC1091
  source "$ROOT/scripts/paths.sh"
  # Chats, password hashes and logs: readable by this macOS user only.
  umask 077
  mkdir -p "$RUN_DIR" "$LOG_DIR" "$DATA_DIR"
  chmod 700 "$RUN_DIR" "$LOG_DIR" "$DATA_DIR"
}

is_up() { curl -fs -o /dev/null --max-time 3 "$1" 2>/dev/null; }

# wait_for <url> <display name> <pidfile name>
wait_for() {
  local url="$1" name="$2" pid_name="$3" waited=0
  until is_up "$url"; do
    pid_alive "$pid_name" || fail "$name stopped right after starting. See $LOG_DIR/$pid_name.log."
    (( waited >= START_TIMEOUT_SECONDS )) && fail "$name did not start. See $LOG_DIR."
    sleep 2
    waited=$(( waited + 2 ))
  done
}

# True if the pidfile names a live process that really is ours. After a reboot
# the saved number can belong to an unrelated program, which must not be killed.
pid_alive() {
  local file="$RUN_DIR/$1.pid" pid expected="$1"
  [[ -f "$file" ]] || return 1
  pid="$(cat "$file")"
  # The chat software runs as scripts/serve.py (as "open-webui serve" before that).
  [[ "$expected" == "webui" ]] && expected="open-webui|serve\.py"
  if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -Eq "$expected"; then
    return 0
  fi
  rm -f "$file"
  return 1
}

start_ollama() {
  if is_up "$OLLAMA_URL/api/version"; then
    if ! pid_alive ollama; then
      echo "Ollama is already running outside this script (for example the Ollama app)."
      echo "  Its context length is whatever that app is set to, not CONTEXT_LENGTH,"
      echo "  and it keeps models in its own folder on the Mac's disk, not $MODELS_DIR."
      echo "  Quit it and run this again to let this script manage it."
    fi
    return
  fi
  mkdir -p "$MODELS_DIR" 2>/dev/null || fail "Cannot use $MODELS_DIR for models. Is the drive plugged in?"
  # 127.0.0.1: only Open WebUI on this machine may talk to the model directly.
  # Keep the chat and search models in memory for good: reloading several GB
  # (slow from an external drive) is the longest wait there is.
  # Memory: flash attention and an 8-bit conversation cache roughly halve what
  # each conversation takes, which matters most on a 16 GB Mac. Both can be
  # overridden in settings.env.
  OLLAMA_HOST="${OLLAMA_URL#http://}" \
  OLLAMA_MODELS="$MODELS_DIR" \
  OLLAMA_NO_CLOUD=1 \
  OLLAMA_CONTEXT_LENGTH="$CONTEXT_LENGTH" \
  OLLAMA_KEEP_ALIVE=-1 \
  OLLAMA_MAX_LOADED_MODELS=2 \
  OLLAMA_NUM_PARALLEL="${PARALLEL_CHATS:-1}" \
  OLLAMA_FLASH_ATTENTION="${OLLAMA_FLASH_ATTENTION:-1}" \
  OLLAMA_KV_CACHE_TYPE="${OLLAMA_KV_CACHE_TYPE:-q8_0}" \
    nohup ollama serve >"$LOG_DIR/ollama.log" 2>&1 &
  echo $! >"$RUN_DIR/ollama.pid"
  wait_for "$OLLAMA_URL/api/version" "Ollama" ollama
}

# model_installed <name>: true if Ollama has it. A name without a tag is ":latest".
model_installed() {
  local tags
  tags="$(curl -fs --max-time 10 "$OLLAMA_URL/api/tags" 2>/dev/null | tr -d ' \n')" || return 1
  grep -qF "\"name\":\"$1\"" <<<"$tags" && return 0
  [[ "$1" == *:* ]] || grep -qF "\"name\":\"$1:latest\"" <<<"$tags"
}

# Without these the chat says "Model not found" and uploads fail.
check_models() {
  local missing=() name
  for name in "$CHAT_MODEL" "$EMBED_MODEL"; do
    model_installed "$name" || missing+=("$name")
  done
  (( ${#missing[@]} == 0 )) && return 0
  echo "WARNING: Ollama does not have: ${missing[*]}"
  echo "  Chats will fail with 'Model not found' until you run: ./privatellm pull"
  return 1
}

# Loads both models now, so the first question does not wait for 6 GB to be
# read from the drive while Open WebUI looks frozen.
warm_up() {
  check_models || return 0
  echo "Loading $CHAT_MODEL into memory (up to a few minutes from an external drive)..."
  curl -fs --max-time "$WARM_UP_TIMEOUT_SECONDS" -o /dev/null "$OLLAMA_URL/api/generate" \
    -d "{\"model\":\"$CHAT_MODEL\",\"keep_alive\":-1}" \
    || echo "Note: could not preload $CHAT_MODEL, so the first answer will be slow. See $LOG_DIR/ollama.log."
  curl -fs --max-time "$WARM_UP_TIMEOUT_SECONDS" -o /dev/null "$OLLAMA_URL/api/embed" \
    -d "{\"model\":\"$EMBED_MODEL\",\"input\":\"warm up\",\"keep_alive\":-1}" \
    || echo "Note: could not preload $EMBED_MODEL. See $LOG_DIR/ollama.log."
}

# Percentage of memory macOS reports as free (the same figure as Activity
# Monitor's memory pressure). Prints nothing on other systems.
free_memory_percent() {
  sysctl -n kern.memorystatus_level 2>/dev/null || true
}

# The programs using the most memory, helpers added together (Chrome runs as many).
biggest_memory_users() {
  ps -axo rss=,ucomm= 2>/dev/null \
    | awk '{ kb = $1; $1 = ""; sub(/^ +/, ""); total[$0] += kb }
           END { for (name in total) printf "%d %s\n", total[name] / 1024, name }' \
    | sort -rn | head -5 | awk '{ size = $1; $1 = ""; printf "    %6d MB %s\n", size, $0 }' || true
}

# warn_if_low_memory [always]: warns when the Mac is short of memory.
warn_if_low_memory() {
  local free
  free="$(free_memory_percent)"
  [[ "$free" =~ ^[0-9]+$ ]] || return 0
  if (( free < LOW_MEMORY_PERCENT )); then
    echo "WARNING: only $free% of memory is free. The Mac may freeze while MIRAH answers."
    echo "  Close other apps, Chrome tabs especially. Using the most memory now:"
    biggest_memory_users
  elif [[ "${1:-}" == "always" ]]; then
    echo "Memory free: $free%. Using the most memory now:"
    biggest_memory_users
  fi
}

# What is loaded, how big, and whether memory is short.
run_doctor() {
  show_status
  echo
  if is_up "$OLLAMA_URL/api/version"; then
    check_models && echo "Both models are installed: $CHAT_MODEL and $EMBED_MODEL."
    echo "Loaded in memory now:"
    OLLAMA_HOST="${OLLAMA_URL#http://}" ollama ps 2>/dev/null || echo "  (could not ask Ollama)"
  fi
  echo
  warn_if_low_memory always
  echo
  echo "If the Mac still freezes with other apps closed, in settings.env:"
  echo "  1. PARALLEL_CHATS=1 (one answer at a time; others wait in turn)"
  echo "  2. CONTEXT_LENGTH=4096 (answers draw on fewer document excerpts)"
  echo "  3. a smaller CHAT_MODEL, then ./privatellm pull and ./privatellm configure"
  echo "  then ./privatellm restart"
}

# Downloads the chat and search models named in settings.env into MODELS_DIR.
run_pull() {
  start_ollama
  OLLAMA_HOST="${OLLAMA_URL#http://}" ollama pull "$CHAT_MODEL"
  OLLAMA_HOST="${OLLAMA_URL#http://}" ollama pull "$EMBED_MODEL"
  check_models && echo "Both models are installed. Run ./privatellm restart."
}

configured() { [[ -s "$RUN_DIR/api-key" ]]; }

# Until the admin account exists, anyone who can reach the site could claim it,
# so stay private to this Mac until ./privatellm configure has run.
listen_address() {
  if configured; then echo "$BIND_ADDRESS"; else echo "127.0.0.1"; fi
}

network_name() {
  if command -v scutil >/dev/null 2>&1; then echo "$(scutil --get LocalHostName).local"; else hostname; fi
}

# Prints the folder the chat software loads its logo and stylesheet from.
webui_static_dir() {
  local program target static
  program="$(command -v open-webui)" || return 1
  target="$(readlink "$program")" || return 1
  [[ "$target" == /* ]] || target="$(dirname "$program")/$target"
  # <tool>/bin/open-webui  ->  <tool>/lib/python3.x/site-packages/open_webui/frontend/static
  for static in "$(dirname "$(dirname "$target")")"/lib/python*/site-packages/open_webui/frontend/static; do
    [[ -d "$static" ]] && { echo "$static"; return 0; }
  done
  return 1
}

# copy_replacing <from dir> <to dir>: copies every file by deleting the old one
# first. Overwriting in place could also alter the installer's cached copy of
# the same file, where the two share storage.
copy_replacing() {
  local relative
  (cd "$1" && find . -type f) | while IFS= read -r relative; do
    mkdir -p "$2/$(dirname "$relative")"
    rm -f "$2/$relative"
    cp "$1/$relative" "$2/$relative"
  done
}

# The chat software adds " (Open WebUI)" after a custom name. Its licence lets
# an install with 50 or fewer users in 30 days remove that, so it is opt-in:
# BRAND_HIDE_OPEN_WEBUI_SUFFIX=true in branding/brand.env.
apply_name_suffix() {
  local settings_file
  settings_file="$(dirname "$(dirname "$1")")/env.py"
  [[ -f "$settings_file" ]] || return 0
  if [[ "${BRAND_HIDE_OPEN_WEBUI_SUFFIX:-false}" == "true" && -d "$BRAND_DIR/static" ]]; then
    [[ -f "$settings_file.original" ]] || cp "$settings_file" "$settings_file.original"
    sed "s/^    WEBUI_NAME += ' (Open WebUI)'\$/    pass  # suffix hidden by branding\/brand.env/" \
      "$settings_file.original" >"$settings_file.new"
    mv -f "$settings_file.new" "$settings_file"
  elif [[ -f "$settings_file.original" ]]; then
    cp "$settings_file.original" "$settings_file.new"
    mv -f "$settings_file.new" "$settings_file"
  fi
}

# Puts the logo and colours from branding/static in place before each start.
# The originals are saved once; removing the branding folder restores them.
apply_branding() {
  local static backup
  static="$(webui_static_dir 2>/dev/null)" || { echo "Note: could not find the chat software's files, so branding was skipped."; return 0; }
  # Kept beside the software, so it always matches the copy it came from.
  backup="$static.original"
  if [[ -d "$BRAND_DIR/static" ]]; then
    [[ -d "$backup" ]] || cp -R "$static" "$backup"
    copy_replacing "$BRAND_DIR/static" "$static"
  elif [[ -d "$backup" ]]; then
    copy_replacing "$backup" "$static"
  fi
  apply_name_suffix "$static"
}

start_webui() {
  if pid_alive webui; then
    echo "Open WebUI is already running."
    return
  fi
  is_up "http://127.0.0.1:$PORT/health" && fail "Something else is already using port $PORT. Change PORT in settings.env."
  apply_branding
  local python
  python="$(webui_python)" || fail "Could not find the chat software. Run ./setup.sh first."
  DATA_DIR="$DATA_DIR" \
  OLLAMA_BASE_URL="$OLLAMA_URL" \
  RAG_OLLAMA_BASE_URL="$OLLAMA_URL" \
  RAG_EMBEDDING_MODEL="$EMBED_MODEL" \
  MIRAH_SCRIPTS_DIR="$ROOT/scripts" \
  MIRAH_CONSENT_NOTICE="$ROOT/config/consent-notice.txt" \
    nohup "$python" "$ROOT/scripts/serve.py" "$(listen_address)" "$PORT" >"$LOG_DIR/webui.log" 2>&1 &
  echo $! >"$RUN_DIR/webui.pid"
  wait_for "http://127.0.0.1:$PORT/health" "Open WebUI" webui
}

stop_one() {
  local name="$1" file="$RUN_DIR/$1.pid"
  if pid_alive "$name"; then
    local pid waited=0
    pid="$(cat "$file")"
    kill "$pid"
    # Wait for it to exit, so a restart does not find the port still taken.
    while kill -0 "$pid" 2>/dev/null; do
      if (( waited >= STOP_TIMEOUT_SECONDS )); then
        kill -9 "$pid" 2>/dev/null || true
        break
      fi
      sleep 1
      waited=$(( waited + 1 ))
    done
    echo "Stopped $name."
  fi
  rm -f "$file"
}

show_status() {
  if is_up "$OLLAMA_URL/api/version"; then echo "Ollama:     running"; else echo "Ollama:     stopped"; fi
  if is_up "http://127.0.0.1:$PORT/health"; then
    echo "Open WebUI: running"
    echo "  On this Mac:        http://localhost:$PORT"
    if ! configured; then
      echo "  Other devices are blocked until you run ./privatellm configure."
    elif [[ "$BIND_ADDRESS" == "0.0.0.0" ]]; then
      echo "  From other devices: http://$(network_name):$PORT"
    fi
  else
    echo "Open WebUI: stopped"
  fi
  echo "Model: $CHAT_MODEL (context $CONTEXT_LENGTH tokens), stored in $MODELS_DIR"
}

run_sync() {
  local key_file="$ROOT/run/api-key" sources="$ROOT/sync/sources.yaml"
  [[ -f "$key_file" ]] || fail "No API key yet. Run ./privatellm configure first."
  [[ -f "$sources" ]] || fail "Copy sync/sources.example.yaml to sync/sources.yaml and edit it first."
  [[ -f "$ROOT/sync/credentials.env" ]] && { set -a; source "$ROOT/sync/credentials.env"; set +a; }
  # Sync mirrors its sources and deletes everything else in the target, so it
  # gets its own knowledge base and never touches hand-uploaded documents.
  local kb_id_file="$ROOT/run/sync-knowledge-id" kb_id
  [[ -s "$kb_id_file" ]] || fail "Run ./privatellm configure once more first: it creates the 'Synced Sources' knowledge base that sync fills."
  kb_id="$(cat "$kb_id_file")"
  # oikb reads .oikb.yaml from the current directory.
  local work="$RUN_DIR/sync"
  mkdir -p "$work"
  sed "s/__KNOWLEDGE_ID__/$kb_id/g" "$sources" >"$work/.oikb.yaml"
  ( cd "$work" && OPEN_WEBUI_URL="http://127.0.0.1:$PORT" OPEN_WEBUI_API_KEY="$(cat "$key_file")" oikb sync "$@" )
}

# The chat software's own Python, which has the password-hashing library.
webui_python() {
  local program target
  program="$(command -v open-webui)" || return 1
  target="$(readlink "$program")" || return 1
  [[ "$target" == /* ]] || target="$(dirname "$program")/$target"
  echo "$(dirname "$target")/python"
}

run_reset_password() {
  local python
  python="$(webui_python)" || fail "Could not find the chat software. Run ./setup.sh first."
  [[ -x "$python" ]] || fail "Could not find the chat software's Python at $python."
  "$python" "$ROOT/scripts/reset_password.py" "$DATA_DIR/webui.db"
}

# Rebuilds the search index for every document. Needed after EMBED_MODEL
# changes, because each search model stores documents in its own format.
run_reindex() {
  configured || fail "Run ./privatellm configure first."
  echo "Re-indexing every document. This can take a while for a large library..."
  curl -fsS -X POST -H "Authorization: Bearer $(cat "$RUN_DIR/api-key")" \
    "http://127.0.0.1:$PORT/api/v1/knowledge/reindex" >/dev/null || fail "Re-index failed. See $LOG_DIR/webui.log."
  echo "Done."
}

# Access levels, the approval queue, export, deletion, audit and training data.
run_govern() {
  configured || fail "Run ./privatellm configure first."
  DATA_DIR="$DATA_DIR" WEBUI_URL="http://127.0.0.1:$PORT" uv run --python 3.12 "$ROOT/scripts/govern.py" "$@"
}

run_configure() {
  local was_configured=no
  configured && was_configured=yes
  WEBUI_URL="http://127.0.0.1:$PORT" uv run --python 3.12 "$ROOT/scripts/configure.py" "$@"
  if [[ "$was_configured" == "no" && "$BIND_ADDRESS" != "127.0.0.1" ]] && configured; then
    echo "Restarting so other devices on your network can connect..."
    stop_one webui
    start_webui
    show_status
  fi
}

main() {
  local command="${1:-status}"
  shift || true
  load_settings
  case "$command" in
    start)        start_ollama; warm_up; warn_if_low_memory; start_webui; show_status ;;
    start-ollama) start_ollama ;;
    stop)         stop_one webui; stop_one ollama ;;
    restart)      stop_one webui; stop_one ollama; start_ollama; warm_up; warn_if_low_memory; start_webui; show_status ;;
    status)       show_status ;;
    doctor)       run_doctor ;;
    pull)         run_pull ;;
    configure)    run_configure "$@" ;;
    sync)         run_sync "$@" ;;
    reset-password) run_reset_password ;;
    reindex)      run_reindex ;;
    skills)       WEBUI_URL="http://127.0.0.1:$PORT" uv run --python 3.12 "$ROOT/scripts/import_skills.py" ;;
    logs)         tail -n 50 -f "$LOG_DIR/webui.log" "$LOG_DIR/ollama.log" ;;
    access|contributor|library|export-user|delete-user|audit|training) run_govern "$command" "$@" ;;
    *)            fail "Unknown command '$command'. Use: start, stop, restart, status, doctor, pull, configure, sync, skills, reset-password, reindex, logs, access, contributor, library, export-user, delete-user, audit, training." ;;
  esac
}

main "$@"
