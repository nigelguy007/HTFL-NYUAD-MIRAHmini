# Open WebUI settings, applied on every start. No secrets in this file.
# Setting names were checked against Open WebUI 0.13.3.

# These settings win over anything changed in the admin screens, so the privacy
# rules below cannot be switched off by accident. To change one, edit this file
# and run ./privatellm restart.
ENABLE_PERSISTENT_CONFIG=false

# --- Nothing leaves this machine ---------------------------------------------
OFFLINE_MODE=true
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_OPENAI_API=false
ENABLE_OLLAMA_API=true
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_WEB_SEARCH=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_IMAGE_GENERATION=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_GOOGLE_DRIVE_INTEGRATION=false
ENABLE_ONEDRIVE_INTEGRATION=false

# --- Accounts ----------------------------------------------------------------
# People sign up themselves, then wait until the admin approves them.
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# Needed by ./privatellm sync.
ENABLE_API_KEYS=true
# New chats start on the Assistant (created by ./privatellm configure).
DEFAULT_MODELS=assistant

# --- Answering from your documents -------------------------------------------
# Embeddings are made by the local Ollama, not downloaded libraries.
RAG_EMBEDDING_ENGINE=ollama
# Keyword search alongside meaning search: helps with names, codes and numbers.
ENABLE_RAG_HYBRID_SEARCH=false
RAG_TOP_K=8
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
# Tells the model each CSV's row count and column names.
ENABLE_RAG_CSV_SUMMARY=true
# Search the knowledge base on every question instead of leaving it to the
# model to decide. Local models are unreliable at deciding.
DEFAULT_MODEL_PARAMS='{"function_calling": "legacy"}'

# --- Keep the Mac responsive -------------------------------------------------
# Each of these would be an extra model call per message.
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
