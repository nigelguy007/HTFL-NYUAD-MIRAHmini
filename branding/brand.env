# Name shown in the browser tab and on the sign-in page.
WEBUI_NAME='MIRAH | The Oracle'

# The chat software normally adds " (Open WebUI)" after a custom name. Its
# licence allows hiding that, and replacing its logo and colours, only while
# 50 or fewer people use this install in any 30 days. Set to false (or delete
# this line) if more people than that will use it.
BRAND_HIDE_OPEN_WEBUI_SUFFIX=true

# The assistant's name in the chat. After changing it, run ./privatellm configure.
ASSISTANT_NAME='MIRAH'
